# Copy to .env (git-ignored) and adjust. Never commit real secrets.

# --- Database (matches docker-compose.yml defaults) ---
DATABASE_URL="postgresql://shadowtrix:shadowtrix_dev@localhost:5433/shadowtrix?schema=public"

# --- App ---
APP_URL="http://localhost:3010"
# REQUIRED. 32+ characters, random. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Keys the HMAC of emails/IPs in rate-limit counters. In production it must not be a placeholder.
AUTH_SECRET=""

# --- Email (Mailpit in development: UI at http://localhost:8025) ---
SMTP_HOST="localhost"
SMTP_PORT="1025"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASSWORD=""
EMAIL_FROM="ShadowTrix <no-reply@shadowtrix.local>"

# --- File storage: "local" or "s3" (s3 = any S3-compatible provider) ---
STORAGE_DRIVER="local"
STORAGE_LOCAL_DIR="./.storage"
S3_ENDPOINT=""
S3_REGION=""
S3_BUCKET=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""

# Internal design-system reference page (/design-system). Keep false in production.
ENABLE_STYLEGUIDE="false"

# --- Authentication & sessions (Milestone 4) ---
# Set true ONLY behind a reverse proxy that overwrites X-Forwarded-For; otherwise the header is attacker-controlled
# and IP-based rate limiting is skipped (per-account limits always apply).
TRUST_PROXY="false"
SESSION_ABSOLUTE_TTL_DAYS="30"
SESSION_IDLE_TTL_DAYS="7"
