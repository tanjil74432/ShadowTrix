// ShadowTrix database schema. See docs/architecture/database-design.md.
// Conventions: UUIDv7 ids, createdAt/updatedAt on mutable tables, snake_case table names.
// Extra integrity rules that Prisma cannot express (CHECK constraints) live in the
// migration SQL (see prisma/migrations/*_integrity_checks).

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  // CommonJS output so Playwright's test loader (which compiles TypeScript to CJS) can import the client.
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

// ───────────────────────── Enums ─────────────────────────

enum UserStatus {
  ACTIVE
  SUSPENDED
}

enum RoleKey {
  PARTICIPANT
  TEAM_LEADER // contextual (derived from TeamMember.role); kept for completeness
  ORGANIZER
  JUDGE
  ADMIN
}

enum AuthTokenType {
  EMAIL_VERIFY
  PASSWORD_RESET
  REFRESH
}

enum OrganizationType {
  PLATFORM_OPERATOR
  UNIVERSITY
  COMMUNITY
  COMPANY
  OTHER
}

enum HostRole {
  HOST
  CO_HOST
  PARTNER
}

enum EventCategory {
  HACKATHON
  DATATHON
  AI_ML
  PROGRAMMING_CONTEST
  WORKSHOP
  SUMMIT
  INNOVATION_CHALLENGE
  OTHER
}

enum EventStatus {
  DRAFT
  PUBLISHED
  CANCELLED
  ARCHIVED
}

/// Administrator review of an event. Independent of publication: publishing is gated on APPROVED only when the platform setting
/// "event approval required" is on (off by default, so existing organizer workflows are unchanged).
enum EventReviewStatus {
  NOT_SUBMITTED
  SUBMITTED
  APPROVED
  CHANGES_REQUESTED
  REJECTED
}

enum AnnouncementAudience {
  ALL
  ORGANIZERS
  PARTICIPANTS
  JUDGES
}

enum RegistrationMode {
  INDIVIDUAL
  TEAM
}

enum LocationType {
  ONLINE
  ONSITE
  HYBRID
}

enum RegistrationStatus {
  PENDING
  CONFIRMED
  WAITLISTED
  CANCELLED
}

enum TeamMemberRole {
  LEADER
  MEMBER
}

enum TeamStatus {
  ACTIVE
  DISBANDED
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  REJECTED
  EXPIRED
  REVOKED
}

enum SubmissionStatus {
  DRAFT
  SUBMITTED
  UNDER_REVIEW
  SCORED
  DISQUALIFIED
}

enum AwardType {
  WINNER
  RUNNER_UP
  FINALIST
  NONE
}

enum CertificateType {
  PARTICIPATION
  FINALIST
  WINNER
}

enum MemberStatus {
  ACTIVE
  FORMER
}

enum Visibility {
  DRAFT
  PUBLISHED
}

// ───────────────────── Identity & access ─────────────────────

model User {
  id              String     @id @default(uuid(7)) @db.Uuid
  email           String     @unique // stored lower-cased (enforced by CHECK)
  passwordHash    String?    @map("password_hash") // null while the signup is pending: set only by the verified mailbox owner
  fullName        String     @map("full_name")
  avatarUrl       String?    @map("avatar_url")
  bio             String?
  emailVerifiedAt DateTime?  @map("email_verified_at") @db.Timestamptz(3)
  status          UserStatus @default(ACTIVE)
  lastLoginAt     DateTime?  @map("last_login_at") @db.Timestamptz(3)
  createdAt       DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime   @updatedAt @map("updated_at") @db.Timestamptz(3)

  roles                 UserRoleAssignment[]
  authTokens            AuthToken[]
  sessions              Session[]
  auditLogs             AuditLog[]
  organizerOf           EventOrganizer[]
  registrations         Registration[]
  teamsLed              Team[]               @relation("TeamLeader")
  teamMemberships       TeamMember[]
  invitationsSent       TeamInvitation[]     @relation("InvitationInviter")
  invitationsRecv       TeamInvitation[]     @relation("InvitationInvitee")
  submissions           Submission[]
  judgeAssignments      JudgeAssignment[]
  scores                Score[]
  certificates          Certificate[]
  announcements         Announcement[]
  announcementsEdited   Announcement[]       @relation("AnnouncementEditor")
  eventsReviewed        Event[]              @relation("EventReviewer")
  createdEvents         Event[]              @relation("EventCreator")
  orgMember             OrgMember?
  submissionVersions    SubmissionVersion[]  @relation("SubmissionVersionAuthor")
  submissionFiles       SubmissionFile[]     @relation("SubmissionFileUploader")
  certificatesIssued    Certificate[]        @relation("CertificateIssuer")
  mfa                   UserMfa?
  mfaRecoveryCodes      MfaRecoveryCode[]
  organizationsVerified Organization[]       @relation("OrganizationVerifier")

  @@index([createdAt], map: "users_created_at_idx")
  @@map("users")
}

/// Global or scoped role grant. eventId / organizationId null = platform-wide.
model UserRoleAssignment {
  id             String   @id @default(uuid(7)) @db.Uuid
  userId         String   @map("user_id") @db.Uuid
  role           RoleKey
  eventId        String?  @map("event_id") @db.Uuid
  organizationId String?  @map("organization_id") @db.Uuid
  grantedById    String?  @map("granted_by_id") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  event        Event?        @relation(fields: [eventId], references: [id], onDelete: Cascade)
  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  // NULLs are distinct in Postgres, so a partial unique index for the
  // global case is added in the integrity migration.
  @@unique([userId, role, eventId, organizationId])
  @@index([userId])
  @@map("user_roles")
}

model AuthToken {
  id        String        @id @default(uuid(7)) @db.Uuid
  userId    String        @map("user_id") @db.Uuid
  type      AuthTokenType
  tokenHash String        @unique @map("token_hash") // SHA-256 of the token; raw token is never stored
  expiresAt DateTime      @map("expires_at") @db.Timestamptz(3)
  usedAt    DateTime?     @map("used_at") @db.Timestamptz(3)
  createdAt DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type])
  @@index([expiresAt])
  @@map("auth_tokens")
}

/// Optional TOTP second factor (administrators). The secret is stored encrypted; enabledAt is null until the user proves the app works.
model UserMfa {
  userId       String    @id @map("user_id") @db.Uuid
  secretEnc    String    @map("secret_enc")
  enabledAt    DateTime? @map("enabled_at") @db.Timestamptz(3)
  lastUsedStep BigInt?   @map("last_used_step") // TOTP time step last accepted: a code cannot be replayed
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_mfa")
}

/// One-time recovery codes for when the authenticator is lost. Only SHA-256 hashes are stored.
model MfaRecoveryCode {
  id        String    @id @default(uuid(7)) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  codeHash  String    @unique @map("code_hash")
  usedAt    DateTime? @map("used_at") @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("mfa_recovery_codes")
}

/// Server-side login session. The browser only holds a random opaque token; we store its SHA-256.
/// A leaked database therefore cannot be used to hijack sessions.
model Session {
  id            String    @id @default(uuid(7)) @db.Uuid
  userId        String    @map("user_id") @db.Uuid
  tokenHash     String    @unique @map("token_hash")
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  lastSeenAt    DateTime  @default(now()) @map("last_seen_at") @db.Timestamptz(3)
  expiresAt     DateTime  @map("expires_at") @db.Timestamptz(3) // absolute lifetime; idle timeout is checked against lastSeenAt
  revokedAt     DateTime? @map("revoked_at") @db.Timestamptz(3)
  revokedReason String?   @map("revoked_reason")
  userAgent     String?   @map("user_agent") // truncated; no IP address is stored

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt])
  @@index([expiresAt])
  @@map("sessions")
}

/// Fixed-window counters for rate limiting, shared by all app instances through Postgres.
/// Keys are HMACs, so no raw emails or IP addresses are stored here.
model RateLimit {
  key         String   @id
  windowStart DateTime @map("window_start") @db.Timestamptz(3)
  count       Int

  @@index([windowStart])
  @@map("rate_limits")
}

model AuditLog {
  id         String   @id @default(uuid(7)) @db.Uuid
  actorId    String?  @map("actor_id") @db.Uuid
  action     String
  entityType String   @map("entity_type")
  entityId   String?  @map("entity_id")
  before     Json?
  after      Json?
  ip         String?
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  actor User? @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([entityType, entityId])
  @@index([actorId, createdAt])
  @@index([createdAt], map: "audit_logs_created_at_idx")
  @@map("audit_logs")
}

model SiteSetting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("site_settings")
}

// ───────────── Organizations (hosts) — NOT multi-tenancy ─────────────
// Single-operator platform (Team EU Shadow). This table lets events record who
// hosts/co-hosts/partners without scoping data per tenant. No row-level tenancy.

model Organization {
  id           String           @id @default(uuid(7)) @db.Uuid
  slug         String           @unique
  name         String
  type         OrganizationType @default(OTHER)
  description  String?
  websiteUrl   String?          @map("website_url")
  logoUrl      String?          @map("logo_url")
  isOperator   Boolean          @default(false) @map("is_operator") // exactly one true (partial unique index)
  verifiedAt   DateTime?        @map("verified_at") @db.Timestamptz(3)
  verifiedById String?          @map("verified_by_id") @db.Uuid
  createdAt    DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)

  eventHosts EventHost[]
  roles      UserRoleAssignment[]
  verifiedBy User?                @relation("OrganizationVerifier", fields: [verifiedById], references: [id], onDelete: SetNull)

  @@map("organizations")
}

// ───────────────────────── Events ─────────────────────────

model Event {
  id                         String            @id @default(uuid(7)) @db.Uuid
  slug                       String            @unique
  title                      String
  category                   EventCategory
  summary                    String
  description                String
  coverImageUrl              String?           @map("cover_image_url")
  status                     EventStatus       @default(DRAFT)
  startsAt                   DateTime          @map("starts_at") @db.Timestamptz(3)
  endsAt                     DateTime          @map("ends_at") @db.Timestamptz(3)
  registrationOpensAt        DateTime          @map("registration_opens_at") @db.Timestamptz(3)
  registrationClosesAt       DateTime          @map("registration_closes_at") @db.Timestamptz(3)
  submissionDeadline         DateTime?         @map("submission_deadline") @db.Timestamptz(3)
  judgingStartsAt            DateTime?         @map("judging_starts_at") @db.Timestamptz(3)
  judgingEndsAt              DateTime?         @map("judging_ends_at") @db.Timestamptz(3)
  resultsAnnouncementAt      DateTime?         @map("results_announcement_at") @db.Timestamptz(3) // planned date; resultsPublishedAt is the actual publication
  registrationManuallyClosed Boolean           @default(false) @map("registration_manually_closed")
  capacity                   Int?
  registrationMode           RegistrationMode  @default(INDIVIDUAL) @map("registration_mode")
  minTeamSize                Int?              @map("min_team_size")
  maxTeamSize                Int?              @map("max_team_size")
  eligibility                String?
  locationType               LocationType      @default(ONLINE) @map("location_type")
  location                   String?
  timezone                   String            @default("UTC")
  resultsPublishedAt         DateTime?         @map("results_published_at") @db.Timestamptz(3)
  reviewStatus               EventReviewStatus @default(NOT_SUBMITTED) @map("review_status")
  reviewNote                 String?           @map("review_note")
  reviewedAt                 DateTime?         @map("reviewed_at") @db.Timestamptz(3)
  reviewedById               String?           @map("reviewed_by_id") @db.Uuid
  createdById                String?           @map("created_by_id") @db.Uuid
  createdAt                  DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt                  DateTime          @updatedAt @map("updated_at") @db.Timestamptz(3)

  createdBy            User?                   @relation("EventCreator", fields: [createdById], references: [id], onDelete: SetNull)
  reviewedBy           User?                   @relation("EventReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  hosts                EventHost[]
  organizers           EventOrganizer[]
  schedule             EventScheduleItem[]
  announcements        Announcement[]
  registrations        Registration[]
  teams                Team[]
  submissions          Submission[]
  criteria             JudgingCriterion[]
  judges               JudgeAssignment[]
  results              Result[]
  certificates         Certificate[]
  certificateTemplates CertificateTemplate[]
  roleGrants           UserRoleAssignment[]
  contributions        OrgMemberContribution[]

  @@index([status, startsAt])
  @@index([reviewStatus])
  @@index([category])
  @@index([status, category, startsAt], map: "events_status_category_starts_idx")
  @@map("events")
}

model EventHost {
  eventId        String   @map("event_id") @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  role           HostRole @default(HOST)

  event        Event        @relation(fields: [eventId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  @@id([eventId, organizationId])
  @@map("event_hosts")
}

model EventOrganizer {
  eventId String  @map("event_id") @db.Uuid
  userId  String  @map("user_id") @db.Uuid
  isLead  Boolean @default(false) @map("is_lead")

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([eventId, userId])
  @@index([userId], map: "event_organizers_user_idx")
  @@map("event_organizers")
}

model EventScheduleItem {
  id          String    @id @default(uuid(7)) @db.Uuid
  eventId     String    @map("event_id") @db.Uuid
  title       String
  description String?
  startsAt    DateTime  @map("starts_at") @db.Timestamptz(3)
  endsAt      DateTime? @map("ends_at") @db.Timestamptz(3)
  sortOrder   Int       @default(0) @map("sort_order")

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([eventId, startsAt])
  @@map("event_schedule_items")
}

model Announcement {
  id          String               @id @default(uuid(7)) @db.Uuid
  eventId     String?              @map("event_id") @db.Uuid // null = platform-wide
  authorId    String?              @map("author_id") @db.Uuid
  title       String
  body        String
  audience    AnnouncementAudience @default(ALL)
  publishedAt DateTime?            @map("published_at") @db.Timestamptz(3) // null = draft; a future time = scheduled
  createdAt   DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime             @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  updatedById String?              @map("updated_by_id") @db.Uuid

  event     Event? @relation(fields: [eventId], references: [id], onDelete: Cascade)
  author    User?  @relation(fields: [authorId], references: [id], onDelete: SetNull)
  updatedBy User?  @relation("AnnouncementEditor", fields: [updatedById], references: [id], onDelete: SetNull)

  @@index([eventId, publishedAt])
  @@map("announcements")
}

// ───────────────── Registration & participant teams ─────────────────

model Team {
  id          String     @id @default(uuid(7)) @db.Uuid
  eventId     String     @map("event_id") @db.Uuid
  name        String
  description String?
  status      TeamStatus @default(ACTIVE)
  leaderId    String     @map("leader_id") @db.Uuid
  createdAt   DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime   @updatedAt @map("updated_at") @db.Timestamptz(3)

  event         Event            @relation(fields: [eventId], references: [id], onDelete: Cascade)
  leader        User             @relation("TeamLeader", fields: [leaderId], references: [id], onDelete: Restrict)
  members       TeamMember[]
  invitations   TeamInvitation[]
  registrations Registration[]
  submission    Submission?

  @@unique([eventId, name])
  @@unique([id, eventId])
  @@map("teams")
}

model TeamMember {
  teamId   String         @map("team_id") @db.Uuid
  eventId  String         @map("event_id") @db.Uuid
  userId   String         @map("user_id") @db.Uuid
  role     TeamMemberRole @default(MEMBER)
  joinedAt DateTime       @default(now()) @map("joined_at") @db.Timestamptz(3)

  team Team @relation(fields: [teamId, eventId], references: [id, eventId], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([teamId, userId])
  @@unique([eventId, userId])
  @@index([userId])
  @@map("team_members")
}

model TeamInvitation {
  id           String           @id @default(uuid(7)) @db.Uuid
  teamId       String           @map("team_id") @db.Uuid
  inviterId    String           @map("inviter_id") @db.Uuid
  inviteeId    String?          @map("invitee_id") @db.Uuid
  inviteeEmail String           @map("invitee_email")
  status       InvitationStatus @default(PENDING)
  tokenHash    String           @unique @map("token_hash")
  expiresAt    DateTime         @map("expires_at") @db.Timestamptz(3)
  respondedAt  DateTime?        @map("responded_at") @db.Timestamptz(3)
  createdAt    DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)

  team    Team  @relation(fields: [teamId], references: [id], onDelete: Cascade)
  inviter User  @relation("InvitationInviter", fields: [inviterId], references: [id], onDelete: Cascade)
  invitee User? @relation("InvitationInvitee", fields: [inviteeId], references: [id], onDelete: SetNull)

  @@index([teamId, status])
  @@index([inviteeEmail])
  @@map("team_invitations")
}

model Registration {
  id           String             @id @default(uuid(7)) @db.Uuid
  eventId      String             @map("event_id") @db.Uuid
  userId       String             @map("user_id") @db.Uuid
  teamId       String?            @map("team_id") @db.Uuid
  status       RegistrationStatus @default(PENDING)
  registeredAt DateTime           @default(now()) @map("registered_at") @db.Timestamptz(3)
  cancelledAt  DateTime?          @map("cancelled_at") @db.Timestamptz(3)
  attended     Boolean            @default(false)

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  team  Team? @relation(fields: [teamId], references: [id], onDelete: SetNull)

  @@unique([eventId, userId])
  @@index([eventId, status])
  @@index([eventId, status, registeredAt], map: "registrations_event_status_registered_idx")
  @@index([userId])
  @@index([registeredAt], map: "registrations_registered_at_idx")
  @@map("registrations")
}

// ───────────────────── Submissions & judging ─────────────────────

model Submission {
  id             String           @id @default(uuid(7)) @db.Uuid
  eventId        String           @map("event_id") @db.Uuid
  ownerId        String           @map("owner_id") @db.Uuid // submitting user (team leader for team events)
  teamId         String?          @unique @map("team_id") @db.Uuid // one submission per team
  title          String
  description    String
  repoUrl        String?          @map("repo_url")
  demoUrl        String?          @map("demo_url")
  extraLinks     String[]         @default([]) @map("extra_links")
  currentVersion Int              @default(0) @map("current_version")
  status         SubmissionStatus @default(DRAFT)
  submittedAt    DateTime?        @map("submitted_at") @db.Timestamptz(3)
  createdAt      DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)

  event    Event               @relation(fields: [eventId], references: [id], onDelete: Cascade)
  owner    User                @relation(fields: [ownerId], references: [id], onDelete: Restrict)
  team     Team?               @relation(fields: [teamId], references: [id], onDelete: SetNull)
  files    SubmissionFile[]
  versions SubmissionVersion[]
  scores   Score[]
  result   Result?

  @@unique([eventId, ownerId])
  @@index([eventId, status])
  @@map("submissions")
}

model SubmissionVersion {
  id           String   @id @default(uuid(7)) @db.Uuid
  submissionId String   @map("submission_id") @db.Uuid
  version      Int
  snapshot     Json
  createdById  String?  @map("created_by_id") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  submission Submission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  createdBy  User?      @relation("SubmissionVersionAuthor", fields: [createdById], references: [id], onDelete: SetNull)

  @@unique([submissionId, version])
  @@map("submission_versions")
}

model SubmissionFile {
  id           String   @id @default(uuid(7)) @db.Uuid
  submissionId String   @map("submission_id") @db.Uuid
  storageKey   String   @unique @map("storage_key")
  originalName String   @map("original_name")
  mimeType     String   @map("mime_type")
  sizeBytes    Int      @map("size_bytes")
  sha256       String?
  uploadedById String?  @map("uploaded_by_id") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  submission Submission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  uploadedBy User?      @relation("SubmissionFileUploader", fields: [uploadedById], references: [id], onDelete: SetNull)

  @@index([submissionId])
  @@map("submission_files")
}

/// Lifecycle of a direct upload (browser -> private bucket through a signed URL). PENDING until the server has verified the
/// stored bytes and attached the file (COMPLETED); REJECTED when verification failed; EXPIRED when the cleanup job reaped an
/// upload that was never completed. Exactly one transition out of PENDING can win (an atomic conditional UPDATE).
enum PendingUploadStatus {
  PENDING
  COMPLETED
  REJECTED
  EXPIRED
}

/// One row per signed upload URL, so abandoned objects can be found and deleted. `submissionId` and `ownerId` are deliberately
/// plain columns without foreign keys: the cleanup job must still be able to delete the object after a submission or user is gone.
model PendingUpload {
  id           String              @id @default(uuid(7)) @db.Uuid
  storageKey   String              @unique @map("storage_key")
  submissionId String              @map("submission_id") @db.Uuid
  ownerId      String              @map("owner_id") @db.Uuid
  contentType  String              @map("content_type")
  declaredSize Int                 @map("declared_size")
  status       PendingUploadStatus @default(PENDING)
  createdAt    DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  expiresAt    DateTime            @map("expires_at") @db.Timestamptz(3)
  resolvedAt   DateTime?           @map("resolved_at") @db.Timestamptz(3)

  @@index([status, expiresAt], map: "pending_uploads_status_expires_idx")
  @@index([ownerId])
  @@map("pending_uploads")
}

/// Why an object is queued for deletion. FILE/PHOTO/CERTIFICATE are written by database triggers when the owning row disappears
/// (including cascades); UPLOAD_* are written by the upload service and the abandoned-upload sweep.
enum StorageDeletionReason {
  FILE_DELETED
  PHOTO_DELETED
  CERTIFICATE_DELETED
  UPLOAD_EXPIRED
  UPLOAD_REJECTED
}

/// Durable storage-deletion outbox. A row is inserted IN THE SAME TRANSACTION as the change that makes an object unreachable, so a
/// rollback also removes the job and a commit can never lose it. The maintenance worker claims rows with a lease (crash recovery,
/// safe concurrency), deletes the object with all its versions OUTSIDE any transaction, and deletes the row only after success.
model StorageDeletion {
  id            String                @id @default(uuid(7)) @db.Uuid
  storageKey    String                @unique @map("storage_key")
  reason        StorageDeletionReason
  attempts      Int                   @default(0)
  createdAt     DateTime              @default(now()) @map("created_at") @db.Timestamptz(3)
  nextAttemptAt DateTime              @default(now()) @map("next_attempt_at") @db.Timestamptz(3)
  lockedUntil   DateTime?             @map("locked_until") @db.Timestamptz(3)
  lastErrorCode String?               @map("last_error_code")

  @@index([nextAttemptAt])
  @@map("storage_deletions")
}

model JudgingCriterion {
  id          String  @id @default(uuid(7)) @db.Uuid
  eventId     String  @map("event_id") @db.Uuid
  name        String
  description String?
  maxScore    Decimal @map("max_score") @db.Decimal(6, 2)
  weight      Decimal @default(1) @db.Decimal(6, 3)
  sortOrder   Int     @default(0) @map("sort_order")

  event  Event   @relation(fields: [eventId], references: [id], onDelete: Cascade)
  scores Score[]

  @@unique([eventId, name])
  @@map("judging_criteria")
}

model JudgeAssignment {
  eventId   String   @map("event_id") @db.Uuid
  judgeId   String   @map("judge_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  judge User  @relation(fields: [judgeId], references: [id], onDelete: Cascade)

  @@id([eventId, judgeId])
  @@map("judge_assignments")
}

model Score {
  id           String    @id @default(uuid(7)) @db.Uuid
  submissionId String    @map("submission_id") @db.Uuid
  judgeId      String    @map("judge_id") @db.Uuid
  criterionId  String    @map("criterion_id") @db.Uuid
  score        Decimal   @db.Decimal(6, 2)
  feedback     String?
  finalizedAt  DateTime? @map("finalized_at") @db.Timestamptz(3)
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  submission Submission       @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  judge      User             @relation(fields: [judgeId], references: [id], onDelete: Restrict)
  criterion  JudgingCriterion @relation(fields: [criterionId], references: [id], onDelete: Cascade)

  @@unique([submissionId, judgeId, criterionId])
  @@index([judgeId])
  @@index([submissionId, judgeId], map: "scores_submission_id_judge_id_idx")
  @@map("scores")
}

model Result {
  id           String    @id @default(uuid(7)) @db.Uuid
  eventId      String    @map("event_id") @db.Uuid
  submissionId String    @unique @map("submission_id") @db.Uuid
  finalScore   Decimal   @map("final_score") @db.Decimal(8, 3)
  rank         Int?
  award        AwardType @default(NONE)
  publishedAt  DateTime? @map("published_at") @db.Timestamptz(3)
  breakdown    Json?
  computedAt   DateTime  @default(now()) @map("computed_at") @db.Timestamptz(3)

  event      Event      @relation(fields: [eventId], references: [id], onDelete: Cascade)
  submission Submission @relation(fields: [submissionId], references: [id], onDelete: Cascade)

  @@index([eventId, rank])
  @@map("results")
}

// ───────────────────────── Certificates ─────────────────────────

model Certificate {
  id            String          @id @default(uuid(7)) @db.Uuid
  publicCode    String          @unique @map("public_code") // non-guessable, shown on certificate + verify URL
  eventId       String          @map("event_id") @db.Uuid
  userId        String          @map("user_id") @db.Uuid
  type          CertificateType
  recipientName String          @map("recipient_name") // snapshot at issue time
  issuedAt      DateTime        @default(now()) @map("issued_at") @db.Timestamptz(3)
  revokedAt     DateTime?       @map("revoked_at") @db.Timestamptz(3)
  storageKey    String?         @map("storage_key")
  revokedReason String?         @map("revoked_reason")
  issuedById    String?         @map("issued_by_id") @db.Uuid

  event    Event @relation(fields: [eventId], references: [id], onDelete: Restrict)
  user     User  @relation(fields: [userId], references: [id], onDelete: Restrict)
  issuedBy User? @relation("CertificateIssuer", fields: [issuedById], references: [id], onDelete: SetNull)

  @@unique([eventId, userId, type])
  @@index([userId])
  @@map("certificates")
}

/// Wording of the certificate PDF for one event and certificate type. A built-in default is used when none exists.
model CertificateTemplate {
  id             String          @id @default(uuid(7)) @db.Uuid
  eventId        String          @map("event_id") @db.Uuid
  type           CertificateType
  heading        String
  body           String
  signatoryName  String?         @map("signatory_name")
  signatoryTitle String?         @map("signatory_title")
  createdAt      DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime        @updatedAt @map("updated_at") @db.Timestamptz(3)

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@unique([eventId, type])
  @@map("certificate_templates")
}

// ───────────── Organization & leadership (public "Our Team") ─────────────
// Naming: "Org*" = the ShadowTrix organization's own people, distinct from
// participant Teams above.

model OrgUnit {
  id           String   @id @default(uuid(7)) @db.Uuid
  slug         String   @unique
  name         String
  description  String?
  displayOrder Int      @default(0) @map("display_order")
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  memberships OrgMembership[]

  @@map("org_units")
}

model Designation {
  id        String @id @default(uuid(7)) @db.Uuid
  title     String @unique
  rankOrder Int    @default(1000) @map("rank_order") // lower = more senior; drives hierarchy display

  memberships OrgMembership[]

  @@map("designations")
}

model OrgTerm {
  id        String    @id @default(uuid(7)) @db.Uuid
  label     String    @unique
  startsOn  DateTime  @map("starts_on") @db.Date
  endsOn    DateTime? @map("ends_on") @db.Date
  isCurrent Boolean   @default(false) @map("is_current") // at most one true (partial unique index)

  memberships OrgMembership[]

  @@map("org_terms")
}

model OrgMember {
  id               String       @id @default(uuid(7)) @db.Uuid
  slug             String       @unique
  fullName         String       @map("full_name")
  photoUrl         String?      @map("photo_url")
  photoKey         String?      @map("photo_key")
  bio              String?
  department       String?
  university       String? // optional: existing members simply have none
  linkedinUrl      String?      @map("linkedin_url")
  githubUrl        String?      @map("github_url")
  portfolioUrl     String?      @map("portfolio_url")
  email            String?
  emailPublic      Boolean      @default(false) @map("email_public") // email is only exposed when true
  responsibilities String?
  skills           String[]
  status           MemberStatus @default(ACTIVE)
  visibility       Visibility   @default(DRAFT)
  isPlaceholder    Boolean      @default(true) @map("is_placeholder") // true until verified info is supplied
  userId           String?      @unique @map("user_id") @db.Uuid
  createdAt        DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)

  user          User?                   @relation(fields: [userId], references: [id], onDelete: SetNull)
  memberships   OrgMembership[]
  contributions OrgMemberContribution[]

  @@index([visibility, status], map: "org_members_public_idx")
  @@map("org_members")
}

/// A member's position in a unit during a term. History is preserved; archiving
/// a former board member sets isArchived/endedOn rather than deleting.
model OrgMembership {
  id            String    @id @default(uuid(7)) @db.Uuid
  memberId      String    @map("member_id") @db.Uuid
  unitId        String    @map("unit_id") @db.Uuid
  designationId String    @map("designation_id") @db.Uuid
  termId        String?   @map("term_id") @db.Uuid
  startedOn     DateTime? @map("started_on") @db.Date
  endedOn       DateTime? @map("ended_on") @db.Date
  displayOrder  Int       @default(0) @map("display_order")
  isArchived    Boolean   @default(false) @map("is_archived")

  member      OrgMember   @relation(fields: [memberId], references: [id], onDelete: Cascade)
  unit        OrgUnit     @relation(fields: [unitId], references: [id], onDelete: Restrict)
  designation Designation @relation(fields: [designationId], references: [id], onDelete: Restrict)
  term        OrgTerm?    @relation(fields: [termId], references: [id], onDelete: SetNull)

  @@unique([memberId, unitId, designationId, termId])
  @@index([unitId, displayOrder])
  @@index([memberId])
  @@map("org_memberships")
}

model OrgMemberContribution {
  id          String  @id @default(uuid(7)) @db.Uuid
  memberId    String  @map("member_id") @db.Uuid
  eventId     String? @map("event_id") @db.Uuid
  description String

  member OrgMember @relation(fields: [memberId], references: [id], onDelete: Cascade)
  event  Event?    @relation(fields: [eventId], references: [id], onDelete: SetNull)

  @@index([memberId])
  @@map("org_member_contributions")
}
